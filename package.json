{
    "name":  "ai-starter",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint .",
                    "typecheck":  "next typegen \u0026\u0026 tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:e2e":  "playwright test",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "node --env-file-if-exists=.env.local scripts/migrate.mts",
                    "e2e:server":  "node scripts/reset-e2e-db.mts \u0026\u0026 npm run db:migrate \u0026\u0026 next build \u0026\u0026 next start -p 3100",
                    "quality":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run test"
                },
    "dependencies":  {
                         "@better-auth/drizzle-adapter":  "^1.7.28",
                         "better-auth":  "^1.7.28",
                         "better-sqlite3":  "^13.2.0",
                         "drizzle-orm":  "^0.45.4",
                         "next":  "16.4.6",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "server-only":  "^0.0.1",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.65.1",
                            "@tailwindcss/turbopack":  "4.3.3",
                            "@types/better-sqlite3":  "^9.6.0",
                            "@types/node":  "^26.6.11",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "drizzle-kit":  "^0.31.11",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.4.6",
                            "tailwindcss":  "4.3.3",
                            "typescript":  "^5",
                            "vitest":  "^5.1.2"
                        },
    "engines":  {
                    "node":  "\u003e=26"
                }
}
